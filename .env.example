# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored and must never be committed.

# Used by the running app (limited user - no CREATE/DROP rights)
DATABASE_URL=postgres://hireatech_app:CHANGE_ME@localhost:5432/hireatech

# Used only by scripts/run-sql.ts to create tables/extensions
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/hireatech

# Read only by scripts/create-admin.ts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD
